{
  "name": "opentofu-up",
  "description": "Plan or apply an exact Google/GCS configuration with private credentials and encrypted emergency state",
  "command": [
    "bin/opentofu-up"
  ],
  "input_schema": {
    "type": "object",
    "properties": {
      "worktree_path": {
        "type": "string",
        "minLength": 1,
        "default": "{{ context.environment.op.worktree_path }}"
      },
      "revision": {
        "type": "string",
        "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
      },
      "root": {
        "type": "string",
        "minLength": 1
      },
      "mode": {
        "type": "string",
        "enum": [
          "plan",
          "up"
        ]
      },
      "backend": {
        "type": "object",
        "properties": {
          "bucket": {
            "type": "string",
            "minLength": 1
          },
          "prefix": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "bucket",
          "prefix"
        ],
        "additionalProperties": false
      },
      "google_auth": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "mode": {
                "const": "oauth_access_token"
              },
              "secret_name": {
                "type": "string",
                "pattern": "^[A-Za-z_][A-Za-z0-9_-]{0,255}$"
              }
            },
            "required": [
              "mode",
              "secret_name"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "mode": {
                "const": "service_account_json"
              },
              "secret_name": {
                "type": "string",
                "pattern": "^[A-Za-z_][A-Za-z0-9_-]{0,255}$"
              },
              "expected_service_account": {
                "type": "string",
                "minLength": 3,
                "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$"
              },
              "impersonate_service_account": {
                "type": "string",
                "minLength": 3,
                "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$"
              }
            },
            "required": [
              "mode",
              "secret_name",
              "expected_service_account"
            ],
            "additionalProperties": false
          }
        ]
      },
      "variables": {
        "type": "object",
        "propertyNames": {
          "pattern": "^[A-Za-z_][A-Za-z0-9_-]*$"
        },
        "additionalProperties": true,
        "default": {}
      },
      "timeout": {
        "type": "string",
        "pattern": "^[1-9][0-9]*[sm]$",
        "default": "30m"
      },
      "lock_timeout": {
        "type": "string",
        "pattern": "^[1-9][0-9]*[sm]$",
        "default": "2m"
      },
      "recovery": {
        "type": "object",
        "properties": {
          "age_recipients": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^age1[0-9a-z]+$"
            }
          }
        },
        "required": [
          "age_recipients"
        ],
        "additionalProperties": false
      }
    },
    "required": [
      "revision",
      "root",
      "mode",
      "backend",
      "google_auth"
    ],
    "additionalProperties": false,
    "allOf": [
      {
        "if": {
          "properties": {
            "mode": {
              "const": "up"
            }
          },
          "required": [
            "mode"
          ]
        },
        "then": {
          "required": [
            "recovery"
          ]
        }
      }
    ]
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "ok": {
        "type": "boolean"
      },
      "outcome": {
        "type": "string",
        "enum": [
          "planned",
          "applied",
          "no_changes",
          "failed",
          "cancelled"
        ]
      },
      "stage": {
        "type": "string",
        "enum": [
          "credentials",
          "preflight",
          "init",
          "validate",
          "plan",
          "apply",
          "recovery",
          "cleanup",
          "complete"
        ]
      },
      "error_category": {
        "type": [
          "string",
          "null"
        ],
        "enum": [
          null,
          "credentials",
          "preflight",
          "command",
          "deadline",
          "cancelled",
          "recovery",
          "cleanup"
        ]
      },
      "exit_code": {
        "type": [
          "integer",
          "null"
        ],
        "minimum": 0,
        "maximum": 255
      },
      "duration_ms": {
        "type": "integer",
        "minimum": 0
      },
      "changes_present": {
        "type": [
          "boolean",
          "null"
        ]
      },
      "revision": {
        "type": "string",
        "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
      },
      "root": {
        "type": "string",
        "minLength": 1
      },
      "backend": {
        "type": "object",
        "properties": {
          "bucket": {
            "type": "string",
            "minLength": 1
          },
          "prefix": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "bucket",
          "prefix"
        ],
        "additionalProperties": false
      },
      "recovery": {
        "type": "object",
        "x-c2j-object-type": "c2ops.opentofu.recovery/v1"
      }
    },
    "required": [
      "ok",
      "outcome",
      "stage",
      "error_category",
      "exit_code",
      "duration_ms",
      "changes_present",
      "revision",
      "root",
      "backend"
    ],
    "additionalProperties": false,
    "allOf": [
      {
        "if": {
          "properties": {
            "ok": {
              "const": true
            }
          },
          "required": [
            "ok"
          ]
        },
        "then": {
          "properties": {
            "outcome": {
              "type": "string",
              "enum": [
                "planned",
                "applied",
                "no_changes"
              ]
            },
            "stage": {
              "const": "complete"
            },
            "error_category": {
              "type": "null"
            }
          },
          "not": {
            "required": [
              "recovery"
            ]
          }
        },
        "else": {
          "properties": {
            "outcome": {
              "type": "string",
              "enum": [
                "failed",
                "cancelled"
              ]
            },
            "stage": {
              "not": {
                "const": "complete"
              }
            },
            "error_category": {
              "type": "string"
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "outcome": {
              "const": "planned"
            }
          },
          "required": [
            "outcome"
          ]
        },
        "then": {
          "properties": {
            "ok": {
              "const": true
            },
            "changes_present": {
              "const": true
            },
            "exit_code": {
              "const": 2
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "outcome": {
              "const": "applied"
            }
          },
          "required": [
            "outcome"
          ]
        },
        "then": {
          "properties": {
            "ok": {
              "const": true
            },
            "changes_present": {
              "const": true
            },
            "exit_code": {
              "const": 0
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "outcome": {
              "const": "no_changes"
            }
          },
          "required": [
            "outcome"
          ]
        },
        "then": {
          "properties": {
            "ok": {
              "const": true
            },
            "changes_present": {
              "const": false
            },
            "exit_code": {
              "const": 0
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "outcome": {
              "const": "cancelled"
            }
          },
          "required": [
            "outcome"
          ]
        },
        "then": {
          "properties": {
            "error_category": {
              "const": "cancelled"
            }
          }
        }
      }
    ]
  }
}
