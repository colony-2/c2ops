{
  "name": "gha-workflow",
  "description": "Submits an Actions workflow as independently scheduled c2j child recipes and collects job results",
  "command": [
    "bin/gha-workflow"
  ],
  "input_schema": {
    "type": "object",
    "properties": {
      "action": {
        "type": "string",
        "enum": [
          "submit",
          "expand",
          "collect",
          "source"
        ],
        "default": "submit"
      },
      "workflow": {
        "type": "string"
      },
      "worktree_path": {
        "type": "string",
        "default": "{{ context.environment.op.worktree_path }}"
      },
      "repository": {
        "type": "string",
        "default": "{{ context.git.repo }}"
      },
      "base_revision": {
        "type": "string",
        "default": "{{ context.git.resolved_hash }}"
      },
      "runner_profiles": {
        "items": {
          "additionalProperties": false,
          "oneOf": [
            {
              "required": [
                "execution_needs"
              ]
            },
            {
              "required": [
                "execution_required"
              ]
            },
            {
              "required": [
                "runner_type"
              ]
            }
          ],
          "properties": {
            "execution_needs": {
              "type": "object"
            },
            "execution_required": {
              "additionalProperties": false,
              "minProperties": 1,
              "properties": {
                "base": {
                  "minLength": 1,
                  "type": "string"
                },
                "capabilities": {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                "resources": {
                  "additionalProperties": false,
                  "properties": {
                    "cpu": {
                      "minLength": 1,
                      "type": "string"
                    },
                    "ephemeral-storage": {
                      "minLength": 1,
                      "type": "string"
                    },
                    "memory": {
                      "minLength": 1,
                      "type": "string"
                    }
                  },
                  "type": "object"
                }
              },
              "type": "object"
            },
            "labels": {
              "items": {
                "type": "string"
              },
              "minItems": 1,
              "type": "array"
            },
            "runner_type": {
              "additionalProperties": false,
              "properties": {
                "architecture": {
                  "type": "string"
                },
                "image": {
                  "type": "string"
                },
                "size": {
                  "type": "string"
                }
              },
              "required": [
                "image",
                "architecture",
                "size"
              ],
              "type": "object"
            }
          },
          "required": [
            "labels"
          ],
          "type": "object"
        },
        "type": "array"
      },
      "source_credential": {
        "type": "string",
        "description": "Explicit secret_bindings alias used only for authorized source history preparation"
      },
      "event_name": {
        "type": "string",
        "default": "workflow_dispatch"
      },
      "event": {
        "type": "object"
      },
      "changed_paths": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "env": {
        "type": "object",
        "additionalProperties": {
          "type": "string"
        }
      },
      "vars": {
        "type": "object",
        "additionalProperties": {
          "type": "string"
        }
      },
      "secret_bindings": {
        "type": "object",
        "description": "GHA secret names mapped to c2j secret names; supply names, never secret values",
        "additionalProperties": {
          "type": "string"
        }
      },
      "helper_op": {
        "type": "string"
      },
      "executor_op": {
        "type": "string"
      },
      "payload": {
        "type": "string"
      },
      "needs": {
        "type": "object"
      },
      "observations": {
        "type": "array",
        "items": {
          "type": "object"
        }
      },
      "execution_mode": {
        "enum": [
          "static",
          "negotiate"
        ],
        "type": "string"
      }
    }
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "status": {
        "type": "string"
      },
      "job_id": {
        "type": "string"
      },
      "goal_id": {
        "type": "string"
      },
      "tenant_id": {
        "type": "string"
      },
      "jobs": {
        "type": "object"
      },
      "conclusion": {
        "type": "string"
      },
      "outputs": {
        "type": "object"
      },
      "assignments": {
        "description": "Internal collect output; decoded public assignment identities, not the awaited workflow result",
        "type": "array",
        "items": {
          "type": "object"
        }
      }
    }
  }
}
