{
  "name": "gha",
  "description": "Runs the gha.run Go implementation through the extension mechanism",
  "command": [
    "bin/gha"
  ],
  "input_schema": {
    "type": "object",
    "required": [
      "workflow"
    ],
    "properties": {
      "workflow": {
        "type": "string"
      },
      "with": {
        "type": "object"
      },
      "env": {
        "type": "object",
        "additionalProperties": {
          "type": "string"
        }
      },
      "secrets": {
        "type": "object",
        "additionalProperties": {
          "type": "string",
          "x-secret": true
        }
      },
      "backend": {
        "type": "string",
        "default": "c2j"
      },
      "runner_profiles": {
        "items": {
          "additionalProperties": false,
          "oneOf": [
            {
              "required": [
                "execution_needs"
              ]
            },
            {
              "required": [
                "execution_required"
              ]
            },
            {
              "required": [
                "runner_type"
              ]
            }
          ],
          "properties": {
            "execution_needs": {
              "type": "object"
            },
            "execution_required": {
              "additionalProperties": false,
              "minProperties": 1,
              "properties": {
                "base": {
                  "minLength": 1,
                  "type": "string"
                },
                "capabilities": {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                "resources": {
                  "additionalProperties": false,
                  "properties": {
                    "cpu": {
                      "minLength": 1,
                      "type": "string"
                    },
                    "ephemeral-storage": {
                      "minLength": 1,
                      "type": "string"
                    },
                    "memory": {
                      "minLength": 1,
                      "type": "string"
                    }
                  },
                  "type": "object"
                }
              },
              "type": "object"
            },
            "labels": {
              "items": {
                "type": "string"
              },
              "minItems": 1,
              "type": "array"
            },
            "runner_type": {
              "additionalProperties": false,
              "properties": {
                "architecture": {
                  "type": "string"
                },
                "image": {
                  "type": "string"
                },
                "size": {
                  "type": "string"
                }
              },
              "required": [
                "image",
                "architecture",
                "size"
              ],
              "type": "object"
            }
          },
          "required": [
            "labels"
          ],
          "type": "object"
        },
        "type": "array"
      },
      "secret_bindings": {
        "type": "object",
        "description": "For backend c2j, map GHA secret names to c2j secret names (never resolved values)",
        "additionalProperties": {
          "type": "string"
        }
      },
      "source_credential": {
        "type": "string",
        "description": "Explicit secret_bindings alias used only for authorized source history preparation"
      },
      "event_name": {
        "type": "string"
      },
      "event": {
        "type": "object"
      },
      "changed_paths": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "vars": {
        "type": "object",
        "additionalProperties": {
          "type": "string"
        }
      },
      "helper_op": {
        "type": "string"
      },
      "executor_op": {
        "type": "string"
      },
      "runner_image": {
        "type": "string"
      },
      "container_architecture": {
        "type": "string"
      },
      "timeout": {
        "type": "string"
      },
      "continue_on_error": {
        "type": "boolean"
      },
      "remote": {
        "type": "object",
        "properties": {
          "push_to": {
            "type": "string"
          },
          "ref_prefix": {
            "type": "string"
          }
        }
      },
      "git_context": {
        "type": "object",
        "default": {
          "base_repo": "{{ context.git.repo }}",
          "base_ref": "{{ context.git.ref }}",
          "resolved_base_hash": "{{ context.git.resolved_hash }}",
          "persist_hash": "{{ context.git.hash }}",
          "parent_hash": "{{ context.git.parent_hash }}",
          "invoke_hash": "{{ context.invocation.hash }}",
          "worktree_path": "{{ context.environment.op.worktree_path }}"
        },
        "properties": {
          "base_repo": {
            "type": "string",
            "default": "{{ context.git.repo }}"
          },
          "base_ref": {
            "type": "string",
            "default": "{{ context.git.ref }}"
          },
          "resolved_base_hash": {
            "type": "string",
            "default": "{{ context.git.resolved_hash }}"
          },
          "persist_hash": {
            "type": "string",
            "default": "{{ context.git.hash }}"
          },
          "parent_hash": {
            "type": "string",
            "default": "{{ context.git.parent_hash }}"
          },
          "invoke_hash": {
            "type": "string",
            "default": "{{ context.invocation.hash }}"
          },
          "worktree_path": {
            "type": "string",
            "default": "{{ context.environment.op.worktree_path }}"
          }
        }
      },
      "execution_mode": {
        "enum": [
          "static",
          "negotiate"
        ],
        "type": "string"
      }
    }
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "job_id": {
        "type": "string"
      },
      "goal_id": {
        "type": "string"
      },
      "tenant_id": {
        "type": "string"
      },
      "submitted_jobs": {
        "type": "object"
      },
      "status": {
        "type": "string"
      },
      "exit_code": {
        "type": "integer"
      },
      "duration_seconds": {
        "type": "integer"
      },
      "error_message": {
        "type": "string"
      },
      "workflow": {
        "type": "object"
      },
      "jobs": {
        "type": "object"
      }
    }
  }
}
