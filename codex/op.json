{
  "name": "codex",
  "description": "Runs Codex via the selector-backed extension mechanism",
  "command": [
    "bin/codex"
  ],
  "timeout": "30m",
  "input_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "prompt"
    ],
    "properties": {
      "prompt": {
        "type": "string"
      },
      "session": {
        "type": "object",
        "x-c2j-object-type": "c2ops.codex.session/v1"
      },
      "model": {
        "type": "string"
      },
      "api": {
        "type": [
          "object",
          "null"
        ],
        "description": "External Responses API from tenant settings; used only when both URL and credentials are available. Set null to disable.",
        "additionalProperties": false,
        "required": [
          "base_url"
        ],
        "properties": {
          "base_url": {
            "type": [
              "string",
              "null"
            ],
            "default": "${{ context.config.?codex_api_base_url.orValue(null) }}",
            "description": "API base URL including /v1, without /responses. Null or empty retains the default provider."
          },
          "api_key": {
            "type": "string",
            "x-secret": true,
            "minLength": 1,
            "default": "${{ context.secrets.?codex_api_key.orValue(null) }}",
            "description": "Proxy client key from context.secrets; omit with orValue(null) to retain the default provider."
          },
          "api_key_env": {
            "type": "string",
            "description": "Explicit worker environment variable containing a bearer token; overrides api_key for legacy recipes."
          }
        }
      },
      "env": {
        "type": "object",
        "additionalProperties": {
          "type": "string"
        }
      },
      "skills": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "return_on": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "status_contract": {
        "type": "object"
      },
      "idle_timeout": {
        "type": "string",
        "default": "5m"
      },
      "workdir_path": {
        "type": "string",
        "default": "{{ context.environment.op.workdir }}"
      },
      "worktree_path": {
        "type": "string",
        "default": "{{ context.environment.op.worktree_path }}"
      },
      "artifact_inbox_path": {
        "type": "string",
        "default": "{{ context.environment.op.inbox }}"
      },
      "artifact_outbox_path": {
        "type": "string",
        "default": "{{ context.environment.op.outbox }}"
      }
    }
  },
  "output_schema": {
    "type": "object",
    "required": [
      "session"
    ],
    "properties": {
      "session": {
        "type": "object",
        "x-c2j-object-type": "c2ops.codex.session/v1"
      },
      "status": {
        "type": "string"
      },
      "sessionId": {
        "type": "string"
      },
      "assistantSummary": {
        "type": "string"
      },
      "incompleteReason": {
        "type": "string"
      },
      "incompleteCategory": {
        "type": "string"
      },
      "pendingDependencies": {
        "type": "array",
        "items": {
          "type": "object"
        }
      },
      "skills_installed": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "outcome": {
        "type": "object"
      }
    }
  }
}
