            "url": {
              "type": "string",
              "format": "uri",
              "pattern": "^https://[^/@?#\\s]+(?:/[^?#\\s]*)?/$"
            },
            "integrity": {
              "$ref": "#/$defs/integrity"
            },
            "observed_integrity": {
              "$ref": "#/$defs/integrity"
            },
            "outcome": {
              "enum": [
                "published",
                "reconciled",
                "not_attempted"
              ]
            }
          },
          "required": [
            "url",
            "integrity",
            "outcome"
          ],
          "additionalProperties": false
        },
        "phase": {
          "type": "string",
          "enum": [
            "prepare",
            "publish"
          ]
        }
      },
      "required": [
        "intent",
        "files",
        "provenance",
        "package",
        "release",
        "install_check",
        "registry"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "required": [
              "phase"
            ],
            "properties": {
              "phase": {
                "const": "prepare"
              }
            }
          },
          "then": {
            "properties": {
              "registry": {
                "properties": {
                  "outcome": {
                    "const": "not_attempted"
                  }
                },
                "not": {
                  "required": [
                    "observed_integrity"
                  ]
                }
              }
            }
          },
          "else": {
            "properties": {
              "registry": {
                "required": [
                  "observed_integrity"
                ],
                "properties": {
                  "outcome": {
                    "enum": [
                      "published",
                      "reconciled"
                    ]
                  }
                }
              }
            }
          }
        }
      ]
    },
