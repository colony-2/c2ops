            "amd64",
            "arm64"
          ]
        },
        "download_url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://github\\.com/"
        }
      },
      "required": [
        "schema_version",
        "release_id",
        "repository",
        "source_commit",
        "version",
        "tag",
        "name",
        "size",
        "sha256",
        "kind",
        "download_url"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "binary",
                  "archive"
                ]
              }
            }
          },
          "then": {
            "required": [
              "goos",
              "goarch"
            ]
          },
          "else": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "goos"
                  ]
                },
                {
                  "required": [
                    "goarch"
                  ]
                }
              ]
            }
          }
        }
      ]
    },
    "release": {
      "type": "object",
      "properties": {
        "id": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          ]
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://github\\.com/"
        },
        "tag": {
          "type": "string",
          "minLength": 2,
          "maxLength": 256,
          "pattern": "^v[^\\s/]+$"
        },
        "commit": {
          "type": "string",
          "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
        },
        "public": {
          "const": true
        },
        "draft": {
          "const": false
        },
        "assets": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": {
            "$ref": "#/$defs/asset"
          }
        }
      },
      "required": [
        "id",
        "url",
        "tag",
        "commit",
        "public",
        "draft",
        "assets"
      ],
      "additionalProperties": false
