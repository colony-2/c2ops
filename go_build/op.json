{
  "name": "go.build",
  "description": "Build release binaries from verified Git objects with automatic or manual pinned Nix Go SDK selection",
  "command": [
    "bin/go-build"
  ],
  "input_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "intent",
      "worktree_path",
      "artifact_inbox_path",
      "artifact_outbox_path",
      "entrypoint"
    ],
    "properties": {
      "intent": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schema_version",
          "release_id",
          "repository",
          "source_commit",
          "target_branch",
          "version",
          "tag",
          "build_date",
          "binary_name"
        ],
        "properties": {
          "schema_version": {
            "const": 1
          },
          "release_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "repository": {
            "type": "string",
            "minLength": 1,
            "pattern": "^github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$",
            "not": {
              "pattern": "^github\\.com/(?:\\.\\.?/|[^/]+/\\.\\.?$)"
            }
          },
          "source_commit": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
          },
          "target_branch": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
          },
          "tag": {
            "type": "string",
            "minLength": 1
          },
          "build_date": {
            "type": "string",
            "minLength": 1,
            "format": "date-time"
          },
          "binary_name": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
          }
        }
      },
      "worktree_path": {
        "type": "string",
        "minLength": 1,
        "default": "{{ context.environment.op.worktree_path }}"
      },
      "artifact_inbox_path": {
        "type": "string",
        "minLength": 1,
        "default": "{{ context.environment.op.inbox }}"
      },
      "artifact_outbox_path": {
        "type": "string",
        "minLength": 1,
        "default": "{{ context.environment.op.outbox }}"
      },
      "entrypoint": {
        "type": "string",
        "minLength": 1
      },
      "module_dir": {
        "type": "string",
        "minLength": 1,
        "default": "."
      },
      "go_version": {
        "type": "string",
        "minLength": 1
      },
      "go_version_file": {
        "type": "string",
        "minLength": 1
      },
      "targets": {
        "type": "array",
        "minItems": 1,
        "maxItems": 4,
        "uniqueItems": true,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "goos",
            "goarch"
          ],
          "properties": {
            "goos": {
              "enum": [
                "darwin",
                "linux"
              ]
            },
            "goarch": {
              "enum": [
                "amd64",
                "arm64"
              ]
            }
          }
        }
      },
      "linker_values": {
        "type": "object",
        "maxProperties": 64,
        "additionalProperties": {
          "type": "string",
          "maxLength": 4096
        }
      },
      "build_tags": {
        "type": "array",
        "maxItems": 64,
        "items": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_]+$"
        }
      }
    }
  },
  "output_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "intent",
      "files",
      "provenance"
    ],
    "properties": {
      "intent": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schema_version",
          "release_id",
          "repository",
          "source_commit",
          "target_branch",
          "version",
          "tag",
          "build_date",
          "binary_name"
        ],
        "properties": {
          "schema_version": {
            "const": 1
          },
          "release_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "repository": {
            "type": "string",
            "minLength": 1,
            "pattern": "^github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$",
            "not": {
              "pattern": "^github\\.com/(?:\\.\\.?/|[^/]+/\\.\\.?$)"
            }
          },
          "source_commit": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
          },
          "target_branch": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
          },
          "tag": {
            "type": "string",
            "minLength": 1
          },
          "build_date": {
            "type": "string",
            "minLength": 1,
            "format": "date-time"
          },
          "binary_name": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
          }
        }
      },
      "files": {
        "type": "array",
        "minItems": 2,
        "maxItems": 5,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schema_version",
            "release_id",
            "repository",
            "source_commit",
            "version",
            "tag",
            "name",
            "size",
            "sha256",
            "kind"
          ],
          "properties": {
            "schema_version": {
              "const": 1
            },
            "release_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "repository": {
              "type": "string",
              "minLength": 1,
              "pattern": "^github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$",
              "not": {
                "pattern": "^github\\.com/(?:\\.\\.?/|[^/]+/\\.\\.?$)"
              }
            },
            "source_commit": {
              "type": "string",
              "minLength": 1,
              "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
            },
            "version": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
            },
            "tag": {
              "type": "string",
              "minLength": 1
            },
            "name": {
              "type": "string",
              "minLength": 1
            },
            "size": {
              "type": "integer",
              "minimum": 0
            },
            "sha256": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[0-9a-f]{64}$"
            },
            "kind": {
              "enum": [
                "binary",
                "document"
              ]
            },
            "goos": {
              "enum": [
                "linux",
                "darwin"
              ]
            },
            "goarch": {
              "enum": [
                "amd64",
                "arm64"
              ]
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "kind": {
                    "const": "binary"
                  }
                }
              },
              "then": {
                "required": [
                  "goos",
                  "goarch"
                ]
              },
              "else": {
                "not": {
                  "anyOf": [
                    {
                      "required": [
                        "goos"
                      ]
                    },
                    {
                      "required": [
                        "goarch"
                      ]
                    }
                  ]
                }
              }
            }
          ]
        }
      },
      "provenance": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schema_version",
          "source",
          "sdk",
          "build"
        ],
        "properties": {
          "schema_version": {
            "const": 1
          },
          "source": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "commit",
              "tree",
              "object_format",
              "policy",
              "path_count",
              "inventory_name",
              "inventory_sha256"
            ],
            "properties": {
              "commit": {
                "type": "string",
                "minLength": 1,
                "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
              },
              "tree": {
                "type": "string",
                "minLength": 1,
                "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
              },
              "object_format": {
                "enum": [
                  "sha1",
                  "sha256"
                ]
              },
              "policy": {
                "const": "git-tree-blobs-v1"
              },
              "path_count": {
                "type": "integer",
                "minimum": 0
              },
              "inventory_name": {
                "type": "string",
                "minLength": 1
              },
              "inventory_sha256": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          },
          "sdk": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "requested",
              "resolved_version",
              "actual_version",
              "nixpkgs_revision",
              "attribute",
              "store_path",
              "compiler_path",
              "host_system",
              "selection_file",
              "directive"
            ],
            "properties": {
              "requested": {
                "type": "string",
                "minLength": 1
              },
              "resolved_version": {
                "type": "string",
                "minLength": 1
              },
              "actual_version": {
                "type": "string",
                "minLength": 1
              },
              "nixpkgs_revision": {
                "type": "string",
                "minLength": 1
              },
              "attribute": {
                "type": "string",
                "minLength": 1
              },
              "store_path": {
                "type": "string",
                "minLength": 1
              },
              "compiler_path": {
                "type": "string",
                "minLength": 1
              },
              "host_system": {
                "type": "string",
                "minLength": 1
              },
              "selection_file": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "directive": {
                "anyOf": [
                  {
                    "enum": [
                      "go",
                      "toolchain"
                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          },
          "build": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "module_dir",
              "entrypoint",
              "workspace_file",
              "targets",
              "linker_symbols",
              "linker_values_sha256",
              "environment",
              "flags",
              "assembly_policy"
            ],
            "properties": {
              "module_dir": {
                "type": "string",
                "minLength": 1
              },
              "entrypoint": {
                "type": "string",
                "minLength": 1
              },
              "workspace_file": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "targets": {
                "type": "array",
                "minItems": 1,
                "maxItems": 4,
                "uniqueItems": true,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "goos",
                    "goarch"
                  ],
                  "properties": {
                    "goos": {
                      "enum": [
                        "darwin",
                        "linux"
                      ]
                    },
                    "goarch": {
                      "enum": [
                        "amd64",
                        "arm64"
                      ]
                    }
                  }
                }
              },
              "linker_symbols": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "linker_values_sha256": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[0-9a-f]{64}$"
              },
              "environment": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "CGO_ENABLED",
                  "GOENV",
                  "GOTOOLCHAIN",
                  "GOROOT",
                  "GOWORK"
                ],
                "properties": {
                  "CGO_ENABLED": {
                    "type": "string",
                    "minLength": 1
                  },
                  "GOENV": {
                    "type": "string",
                    "minLength": 1
                  },
                  "GOTOOLCHAIN": {
                    "type": "string",
                    "minLength": 1
                  },
                  "GOROOT": {
                    "type": "string",
                    "minLength": 1
                  },
                  "GOWORK": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "flags": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "assembly_policy": {
                "const": "contained-includes-v1"
              }
            }
          }
        }
      }
    }
  }
}
